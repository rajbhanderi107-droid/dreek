# One of these two gives DREEK a brain.
#
# 1. API key - the better path. Streaming, plus DREEK's own tool set
#    (screen capture, files, clipboard, system control, reminders).
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-sonnet-5.
# DREEK_MODEL=claude-opus-5

# Optional. Point at a gateway, proxy, or a local stub for testing.
# DREEK_API_URL=https://api.anthropic.com/v1/messages

# Optional. Defaults to 4173.
# DREEK_PORT=4173

# 2. No key? Run `claude setup-token` once instead and DREEK falls back to the
#    Claude Code CLI. No streaming, and no screen capture (it cannot take images).
